  "capabilities": {
    "whatsappAutomation": true,
    "githubIntegration": true,
    "issueManagement": true,
    "pullRequestHandling": true,
    "codeReview": true,
    "notifications": true,
    "logging": true,
    "messageProcessing": true,
    "sessionManagement": true
